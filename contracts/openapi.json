        },
        "type": "object",
        "required": [
          "citation_id",
          "title",
          "url",
          "snippet"
        ],
        "title": "Citation"
      },
      "ConversationIn": {
        "properties": {
          "client_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Id"
          },
          "registration_grant": {
            "type": "string",
            "minLength": 20,
            "title": "Registration Grant"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "registration_grant"
        ],
        "title": "ConversationIn",
        "examples": [
          {
            "client_id": "01900000-0000-7000-8000-000000000000",
            "registration_grant": "one-time-grant-from-registration"
          }
        ]
      },
      "ConversationInfo": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "quota": {
            "$ref": "#/components/schemas/Quota"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "expires_at",
          "quota"
        ],
        "title": "ConversationInfo"
      },
      "ConversationOut": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "quota": {
            "$ref": "#/components/schemas/Quota"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "access_token",
          "expires_at",
          "quota"
        ],
        "title": "ConversationOut",
        "examples": [
          {
            "access_token": "opaque-random-token",
            "conversation_id": "01900000-0000-7000-8000-000000000001",
            "expires_at": "2026-10-25T12:00:00Z",
            "quota": {
              "limit": 100,
              "remaining": 100,
              "used": 0
            }
          }
        ]
      },
      "ErrorOut": {
