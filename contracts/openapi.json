  "components": {
    "schemas": {
      "AnswerOut": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "grounded": {
            "type": "boolean",
            "title": "Grounded"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "quota": {
            "$ref": "#/components/schemas/Quota"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "conversation_id",
          "answer",
          "grounded",
          "citations",
          "quota",
          "request_id"
        ],
        "title": "AnswerOut",
        "examples": [
          {
            "answer": "Use bounded batches. [c1]",
            "citations": [
              {
                "citation_id": "c1",
                "snippet": "Relevant passage",
                "source_type": "article",
                "title": "Example article",
                "url": "https://mobinshaterian.com/blog/example"
              }
            ],
            "conversation_id": "01900000-0000-7000-8000-000000000001",
            "grounded": true,
            "message_id": "01900000-0000-7000-8000-000000000002",
            "quota": {
              "limit": 100,
              "remaining": 99,
              "used": 1
            },
            "request_id": "01900000-0000-7000-8000-000000000003"
          }
        ]
      },
      "Citation": {
        "properties": {
          "citation_id": {
            "type": "string",
            "title": "Citation Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "source_type": {
            "type": "string",
            "const": "article",
            "title": "Source Type",
            "default": "article"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
