{"nodes": [{"id": "post_stop_picking_an_ai_model_start_picking_a_capability_3bf2eeb9bf2d", "label": "Stop Picking an AI Model. Start Picking a Capability.", "file_type": "document", "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Picking one model for everything is like standardizing an entire engineering org on a single EC2 instance type; coupling tooling to a capability keeps model churn in routing config rather than the codebase."}, {"id": "concept_capability_routing", "label": "Capability Routing", "file_type": "concept", "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A design-time decision based on what the task looks like, not a runtime decision based on error codes."}, {"id": "concept_availability_routing", "label": "Availability Routing", "file_type": "concept", "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers whether the preferred model is up right now; a 429 or outage triggers a same-tier fallback."}, {"id": "concept_ai_gateway", "label": "AI Gateway", "file_type": "concept", "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes capability tiers instead of vendor names behind one OpenAI-compatible endpoint, owning the provider decision."}, {"id": "concept_escalation", "label": "Automatic Escalation", "file_type": "concept", "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bumps a request up a tier automatically (cheap to balanced to frontier) based on signals like repeated test failures, instead of waiting for a human to notice the agent is flailing."}, {"id": "concept_engineering_value", "label": "Engineering Value Metric", "file_type": "concept", "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The metric that matters isn't token cost but (Success Probability x Output Quality) / (API Cost + Retry Cost + Developer Time)."}], "edges": [{"source": "post_stop_picking_an_ai_model_start_picking_a_capability_3bf2eeb9bf2d", "target": "concept_capability_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "weight": 1.0}, {"source": "post_stop_picking_an_ai_model_start_picking_a_capability_3bf2eeb9bf2d", "target": "concept_availability_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "weight": 1.0}, {"source": "post_stop_picking_an_ai_model_start_picking_a_capability_3bf2eeb9bf2d", "target": "concept_ai_gateway", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "post_Stop-Picking-an-AI-Model--Start-Picking-a-Capability-3bf2eeb9bf2d.md", "source_location": null, "weight": 1.0}, {"source": "post_stop_picking_an_ai_model_start_picking_a_capability_3bf2eeb9bf2d", "target": "concept_escalation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "post_Stop-Picking-an-AI-Model--Start-Pick