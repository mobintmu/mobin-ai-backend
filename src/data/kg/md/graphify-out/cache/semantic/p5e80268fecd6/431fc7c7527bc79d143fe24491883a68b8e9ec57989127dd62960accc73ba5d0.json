{"nodes": [{"id": "post_from_3nf_mysql_to_fast_search_building_a_cdc_powered_read_model_7bfd2300c3c4_article", "label": "CDC-Powered Read Model", "file_type": "document", "source_file": "post_From-3NF-MySQL-to-Fast-Search--Building-a-CDC-Powered-Read-Model-7bfd2300c3c4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The architecture moves expensive join and aggregation work from request time to change time so reads become cheap keyed lookups."}, {"id": "post_from_3nf_mysql_to_fast_search_building_a_cdc_powered_read_model_7bfd2300c3c4_mysql", "label": "MySQL Write Model", "file_type": "concept", "source_file": "post_From-3NF-MySQL-to-Fast-Search--Building-a-CDC-Powered-Read-Model-7bfd2300c3c4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MySQL remains authoritative for transactional writes and is the source of truth."}, {"id": "post_from_3nf_mysql_to_fast_search_building_a_cdc_powered_read_model_7bfd2300c3c4_debezium", "label": "Debezium", "file_type": "concept", "source_file": "post_From-3NF-MySQL-to-Fast-Search--Building-a-CDC-Powered-Read-Model-7bfd2300c3c4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "post_from_3nf_mysql_to_fast_search_building_a_cdc_powered_read_model_7bfd2300c3c4_kafka", "label": "Kafka", "file_type": "concept", "source_file": "post_From-3NF-MySQL-to-Fast-Search--Building-a-CDC-Powered-Read-Model-7bfd2300c3c4.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "post_from_3nf_mysql_to_fast_search_building_a_cdc_powered_read_model_7bfd2300c3c4_projectionservice", "label": "Projection Service", "file_type": "concept", "source_file": "post_From-3NF-MySQL-to-Fast-Search--Building-a-CDC-Powered-Read-Model-7bfd2300c3c4.md", "source_lo