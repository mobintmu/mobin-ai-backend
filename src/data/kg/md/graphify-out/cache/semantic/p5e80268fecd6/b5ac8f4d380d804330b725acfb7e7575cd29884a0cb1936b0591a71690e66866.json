{"nodes": [{"id": "post_a_classic_east_west_traffic_blind_spot_sql_injection_through_trusted_internal_flows_article", "label": "SQL Injection Through Trusted Internal Flows", "file_type": "document", "source_file": "post_A-classic-east-west-traffic-blind-spot--SQL-Injection-Through-Trusted-Internal-Flows-38049dfe4127.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The article explains how unvalidated input forwarded through SSR can bypass perimeter WAF inspection and reach backend database queries."}, {"id": "post_a_classic_east_west_traffic_blind_spot_sql_injection_through_trusted_internal_flows_ssr", "label": "Server-Side Rendering Layer", "file_type": "concept", "source_file": "post_A-classic-east-west-traffic-blind-spot--SQL-Injection-Through-Trusted-Internal-Flows-38049dfe4127.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SSR is treated as part of the attack surface because it receives client input and can proxy requests to internal systems."}, {"id": "post_a_classic_east_west_traffic_blind_spot_sql_injection_through_trusted_internal_flows_waf", "label": "Web Application Firewall", "file_type": "concept", "source_file": "post_A-classic-east-west-traffic-blind-spot--SQL-Injection-Through-Trusted-Internal-Flows-38049dfe4127.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "post_a_classic_east_west_traffic_blind_spot_sql_injection_through_trusted_internal_flows_parameterized_queries", "label": "Parameterized Queries", "file_type": "concept", "source_file": "post_A-classic-east-west-traffic-blind-spot--SQL-Injection-Through-Trusted-Internal-Flows-38049dfe4127.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parameterized queries are recommended as a backend defense even when malic