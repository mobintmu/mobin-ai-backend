{"nodes": [{"id": "post_a_microservice_that_teaches_everything_not_to_do_article", "label": "A Microservice That Teaches Everything Not to Do", "file_type": "document", "source_file": "post_A-Microservice-That-Teaches-Everything-Not-to-Do-e055f7480424.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The article analyzes architectural and operational anti-patterns in a distributed measurement-ingestion microservice and contrasts them with more reliable alternatives."}, {"id": "post_a_microservice_that_teaches_everything_not_to_do_clickhouse", "label": "ClickHouse", "file_type": "concept", "source_file": "post_A-Microservice-That-Teaches-Everything-Not-to-Do-e055f7480424.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The article identifies ClickHouse as the analytical storage target and recommends denormalized columnar modeling for its workload."}, {"id": "post_a_microservice_that_teaches_everything_not_to_do_distributed_coordination", "label": "Deterministic Distributed Coordination", "file_type": "concept", "source_file": "post_A-Microservice-That-Teaches-Everything-Not-to-Do-e055f7480424.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit coordination mechanisms are recommended because random delays only reduce, rather than eliminate, worker collisions."}, {"id": "post_a_microservice_that_teaches_everything_not_to_do_in_memory_lookup", "label": "In-Memory Lookup", "file_type": "concept", "source_file": "post_A-Microservice-That-Teaches-Everything-Not-to-Do-e055f7480424.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetching reference data once and using constant-time in-memory lookups changes the workload from repeated O(n) scans and database calls to one fetch plus O(n) processing."}], "edges": [{"source": "post_a_microservice_that_teaches_everything_not_to_do_article", "target": "post_a_microservice_that_teaches_everything_not_to_do_clickhouse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "post_A-Microservice-That-Teaches-Everything-Not-to-Do-e055f7480424.md", "source_location": null, "weight": 1.0}, {"source": "post_a_microservice_that_teaches_everything_not_to_do_article", "target": "post_a_microservice_that_teaches_everything_not_to_do_distributed_coordination", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "post_A-Microservice-That-Teaches-Everything-Not-to-Do-e055f7480424.md", "source_location": null, "weight": 1.0}, {"source": "post_a_microservice_that_teaches_everything_not_to_do_article", "target": "post_a_microservice_that_teaches_everything_not_to_do_in_memory_lookup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "post_A-Microservice-That-Teaches-Everything-Not-to-Do-e055f7480424.md", "source_location": null, "weight": 1.0}], "hyperedges": []}